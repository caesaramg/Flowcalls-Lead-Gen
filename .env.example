# ---------------------------------------------------------------------------
# Flowcalls prospecting system — copy to .env and fill in what you need.
# Everything here is optional; the app runs with none of it set.
# ---------------------------------------------------------------------------

# Server
PORT=4000
HOST=127.0.0.1

# Access control. Required whenever HOST is not 127.0.0.1 — the server refuses
# to start on a public interface without it, because the database holds real
# business contact data and your call notes.
APP_USER=flowcalls
APP_PASSWORD=
DATABASE_PATH=data/flowcalls.db
LOG_LEVEL=info

# --- Enrichment providers (all opt-in) -------------------------------------
# Without a key the provider is skipped and no request is made.

# Google Places API (New). Rating, reviews, hours, website, phone, Maps URL.
# https://developers.google.com/maps/documentation/places/web-service/overview
GOOGLE_PLACES_API_KEY=

# Companies House public data. Company number, status, incorporation year and
# serving director names. Free key: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Apify — an alternative route to Google Maps data if you would rather not set
# up Google Cloud billing. https://apify.com
APIFY_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR=compass~crawler-google-places

# --- Website crawler politeness --------------------------------------------
ENRICHMENT_USER_AGENT=FlowcallsProspectingBot/0.1 (+internal B2B research; contact: you@yourdomain.co.uk)
HTTP_TIMEOUT_MS=15000
CRAWL_DELAY_MS=1500
MAX_PAGES_PER_SITE=5
RESPECT_ROBOTS_TXT=true

# --- Compliance -------------------------------------------------------------
# How long an unconverted prospect record is kept before `npm run retention:purge`
# offers it for deletion.
RETENTION_MONTHS=24
REQUIRE_TPS_SCREENING=true
